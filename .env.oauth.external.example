# External IdP placeholders: replace every identity.example value before deployment.
APP_MCP_AUTH_MODE=dual
APP_PUBLIC_BASE_URL=https://mcpgame.paulox.dev
APP_OIDC_ISSUER=https://identity.example
APP_OIDC_CLIENT_ID=game-browser
APP_OIDC_CLIENT_SECRET=
APP_SESSION_COOKIE_NAME=game_session
APP_ALLOWED_BROWSER_ORIGINS=https://mcpgame.paulox.dev
APP_OAUTH_MCP_CLIENT_IDS=registered-mcp-host
APP_OAUTH_DATABASE_PATH=/data/oauth.sqlite
APP_OAUTH_ALLOW_LOCALHOST_HTTP=false
APP_WEBSOCKET_TICKET_TTL_SECONDS=30
APP_SESSION_IDLE_SECONDS=900
GATEWAY_OAUTH_MODE=resource_server
GATEWAY_OAUTH_RESOURCE_URL=https://mcpgame.paulox.dev/mcp
GATEWAY_OAUTH_AUTHORIZATION_SERVERS=https://identity.example
GATEWAY_OAUTH_JWKS_URL=https://identity.example/jwks
GATEWAY_OAUTH_REQUIRED_SCOPES=mcp:access
GATEWAY_OAUTH_ALLOW_STATIC_MCP_TOKENS=true
GATEWAY_OAUTH_ALLOW_LOCALHOST_HTTP=false
GATEWAY_ALLOWED_MCP_ORIGINS=
GATEWAY_CORS_ALLOW_ORIGINS=https://mcpgame.paulox.dev
GATEWAY_MCP_STATELESS=true

# Browser OAuth budgets apply separately to trusted IP and verified account.
# APP_OAUTH_BROWSER_RATE_LIMIT_REQUESTS=30
# APP_OAUTH_BROWSER_RATE_LIMIT_WINDOW_SECONDS=60
# APP_OAUTH_BROWSER_RATE_LIMIT_MAXIMUM_KEYS=10000
